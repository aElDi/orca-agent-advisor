{
  "name": "orca-agent-advisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Two-tier second-opinion advisor for Orca coding agents — inspired by Claude Code's /advisor, with invisible headless routing, live model and effort selection, and automatic MCP setup.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aElDi/orca-agent-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/aElDi/orca-agent-advisor/issues"
  },
  "keywords": [
    "orca",
    "orca-plugin",
    "advisor",
    "mcp",
    "claude-code",
    "codex",
    "grok",
    "opencode",
    "ai-agents"
  ],
  "scripts": {
    "types": "orca plugin types .",
    "typecheck": "tsc -p . --noEmit",
    "check:mcp": "node --check src/mcp-server.mjs",
    "validate": "orca plugin validate . --json",
    "test": "orca plugin test . --json",
    "check": "orca plugin check . --json",
    "inspect": "orca plugin inspect . --json",
    "dev": "orca plugin dev watch . --check --json"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
